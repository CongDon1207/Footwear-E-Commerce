PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/footwear-ecommerce
CLIENT_URL=http://localhost:5173

# JWT Configuration
# IMPORTANT: Use strong secrets (at least 32 characters) in production
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRE=15m

# Refresh Token (not JWT-based, stored in DB)
# Note: RefreshToken model handles expiry (7 days default)

# Bank Transfer (optional)
# Used when paymentMethod=bank_transfer
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
